{
  "manifest_version": 3,
  "name": "iCloud 隐私邮箱助手（单浏览器版）",
  "version": "0.3.0",
  "description": "仅操作当前浏览器中的 Apple 隐私邮箱页面。",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["https://account.apple.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://account.apple.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开 iCloud 隐私邮箱助手"
  }
}
